[Unit]
Description=Ad Data Auto Sync and Keyword Monitor Console
After=network.target

[Service]
Type=simple
User=sync-console
Group=sync-console
WorkingDirectory=/opt/automation
ExecStart=/opt/automation/.venv/bin/uvicorn sync_console.app.main:app --host 127.0.0.1 --port 8088
Restart=always
RestartSec=5
EnvironmentFile=/opt/automation/sync_console/.env

[Install]
WantedBy=multi-user.target

