ADSTAR_OSS_OBJECT_KEY=KOL/adstar_token.txt
JZT_OSS_OBJECT_KEY=KOL/jzt_token.txt
JUGUANG_OSS_OBJECT_KEY=KOL/juguang_token.txt

# 告警与通知 (可选)
